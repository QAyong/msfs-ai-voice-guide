{
  "name": "msfs-ai-voice-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm desktop:typecheck && pnpm desktop:build",
    "desktop:dev": "electron-vite dev --entry ./out/main/index.js",
    "desktop:build": "electron-vite build",
    "desktop:preview": "electron-vite preview --entry ./out/main/index.js",
    "desktop:typecheck": "tsc --noEmit --project desktop/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent:check": "node --env-file=.env --import tsx src/main.ts check",
    "agent:dev": "node --env-file=.env --import tsx src/main.ts dev",
    "agent:start": "node --env-file=.env --import tsx src/main.ts start",
    "search": "node --env-file=.env --import tsx src/cli/search.ts",
    "search:test": "node --env-file=.env scripts/test-volcengine-search.mjs",
    "search:smoke": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/e2e/search-api.smoke.test.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm desktop:typecheck && pnpm test && pnpm format:check"
  },
  "dependencies": {
    "@livekit/agents": "^1.5.2",
    "@livekit/agents-plugin-openai": "^1.5.2",
    "@livekit/rtc-node": "0.13.31",
    "@phosphor-icons/react": "^2.1.10",
    "livekit-client": "^2.20.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.1.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
