{
  "name": "msfs-ai-voice-guide",
  "version": "1.0.1-rc.7",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm desktop:typecheck && pnpm desktop:build",
    "desktop:dev": "pnpm msfs:native:build && pnpm msfs:stage:dev && pnpm msfs:use:dev && pnpm global-ptt:build && electron-vite dev",
    "desktop:clean": "node scripts/clean-desktop-output.mjs",
    "desktop:build": "pnpm desktop:clean && pnpm global-ptt:build && pnpm msfs:stage:dev && electron-vite build && node scripts/stage-global-ptt.mjs && node scripts/stage-msfs-cli.mjs --strict out/msfs && node scripts/stage-geo-config.mjs out/msfs && node scripts/stage-livekit-server.mjs out/livekit && node scripts/stage-tts-voice-samples.mjs resources/tts out/tts && node scripts/validate-release-inputs.mjs",
    "desktop:build:release": "node scripts/clean-desktop-output.mjs --incremental && pnpm global-ptt:build && electron-vite build && node scripts/stage-global-ptt.mjs && node scripts/stage-msfs-cli.mjs --strict --release out/msfs && node scripts/stage-geo-config.mjs out/msfs && node scripts/stage-livekit-server.mjs out/livekit && node scripts/stage-tts-voice-samples.mjs resources/tts out/tts && node scripts/validate-release-inputs.mjs",
    "desktop:prepare-release": "node scripts/prepare-release-app.mjs",
    "desktop:archive-artifacts": "node scripts/archive-release-artifacts.mjs",
    "desktop:package": "pnpm desktop:archive-artifacts && pnpm desktop:package:dir && electron-builder --win nsis --x64 --prepackaged release-v2/artifacts/win-unpacked --publish never && node scripts/report-release-artifacts.mjs",
    "desktop:package:dir": "pnpm desktop:typecheck && pnpm desktop:build:release && pnpm desktop:prepare-release && pnpm desktop:validate-release-app && electron-builder --win dir --x64 --publish never && pnpm desktop:patch-icon && pnpm desktop:validate-runtime",
    "desktop:patch-icon": "node scripts/patch-windows-executable-icon.mjs",
    "desktop:validate-release-app": "node scripts/validate-release-app.mjs",
    "desktop:validate-runtime": "node scripts/validate-packaged-runtime-dependencies.mjs release-v2/artifacts/win-unpacked",
    "desktop:preview": "electron-vite preview --entry ./out/main/index.js",
    "desktop:typecheck": "tsc --noEmit --project desktop/tsconfig.json",
    "global-ptt:build": "node scripts/build-global-ptt.mjs",
    "native:build": "pnpm global-ptt:build",
    "msfs:native:build": "node scripts/build-msfs-cli.mjs",
    "msfs:release:snapshot": "node scripts/prepare-msfs-cli-release-snapshot.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent:check": "node --env-file=.env --import tsx src/main.ts check",
    "agent:dev": "node --env-file=.env --import tsx src/main.ts dev",
    "agent:start": "node --env-file=.env --import tsx src/main.ts start",
    "livekit:dev": "node scripts/run-livekit-dev.mjs",
    "search": "node --env-file=.env --import tsx src/cli/search.ts",
    "search:test": "node --env-file=.env scripts/test-volcengine-search.mjs",
    "search:smoke": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/e2e/search-api.smoke.test.ts",
    "guide:preamble:smoke": "node --env-file=.env --import tsx scripts/simulate-guide-tool-preamble.mts",
    "msfs:stage": "node scripts/stage-msfs-cli.mjs resources/msfs out/msfs",
    "msfs:stage:dev": "node scripts/stage-msfs-cli.mjs dev-runtime/msfs-cli",
    "msfs:use:dev": "node --import tsx scripts/activate-msfs-community-version.ts development",
    "msfs:use:app": "node --import tsx scripts/activate-msfs-community-version.ts application",
    "livekit:stage": "node scripts/stage-livekit-server.mjs out/livekit",
    "tts:stage": "node scripts/stage-tts-voice-samples.mjs resources/tts out/tts",
    "tts:samples": "node --env-file=.env --import tsx scripts/tts-voice-samples.ts",
    "msfs:smoke": "node --env-file=.env --import tsx scripts/smoke-msfs-adapter.ts",
    "explore:spike": "node --import tsx scripts/spike-explore-providers.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm desktop:typecheck && pnpm test && pnpm format:check"
  },
  "dependencies": {
    "@livekit/agents": "1.5.2",
    "@livekit/agents-plugin-openai": "1.5.2",
    "@livekit/components-react": "2.9.21",
    "@livekit/protocol": "1.49.0",
    "@livekit/rtc-node": "0.13.31",
    "@phosphor-icons/react": "2.1.10",
    "archiver": "7.0.1",
    "livekit-client": "2.20.1",
    "livekit-server-sdk": "2.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ws": "8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "6.0.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@electron/asar": "3.4.1",
    "electron": "^43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "node-gyp": "^13.0.1",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
