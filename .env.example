# LiveKit Agent worker（实时语音 Agent 工作进程）
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_AGENT_NAME=msfs-voice-guide

# 火山方舟 LLM（大语言模型）：模型使用已开通的 endpoint / model ID
VOLCENGINE_ARK_API_KEY=your_ark_api_key
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_LLM_MODEL=ep-your-model-id

# 豆包语音 STT（语音转文字）。新版 Speech API Key 优先；未设置时使用 App ID + Access Token。
VOLCENGINE_SPEECH_API_KEY=
VOLCENGINE_SPEECH_APP_ID=your_speech_app_id
VOLCENGINE_SPEECH_ACCESS_TOKEN=your_speech_access_token
VOLCENGINE_STT_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
VOLCENGINE_STT_RESOURCE_ID=volc.bigasr.sauc.duration
VOLCENGINE_STT_MODEL=bigmodel
VOLCENGINE_STT_LANGUAGE=zh

# 豆包语音 TTS（文字转语音）：双向流式 WebSocket。
VOLCENGINE_TTS_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_SPEAKER=replace-with-your-licensed-speaker-id
VOLCENGINE_TTS_SAMPLE_RATE=24000
