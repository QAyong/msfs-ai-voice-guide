# LiveKit Agent worker（实时语音 Agent 工作进程）
# 开发态默认由 Electron 自动启动本地 LiveKit；只有明确设为 false 才使用外部/手动服务。
MSFS_AUTO_START_LIVEKIT=true
LIVEKIT_URL=wss://your-livekit-host
# 凭据留空；本地 LiveKit 会由应用自动启动并生成连接凭据。
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 安装版会自动使用 msfs-voice-guide；只有连接自定义 LiveKit Agent 时才需要修改。
LIVEKIT_AGENT_NAME=msfs-voice-guide

# DeepSeek LLM（大语言模型）：OpenAI 兼容 Chat Completions API。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_LLM_MODEL=deepseek-v4-flash

# 豆包语音 STT（语音转文字）。新版 Speech API Key 优先；未设置时使用 App ID + Access Token。
VOLCENGINE_SPEECH_API_KEY=
VOLCENGINE_SPEECH_APP_ID=
VOLCENGINE_SPEECH_ACCESS_TOKEN=
VOLCENGINE_STT_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
VOLCENGINE_STT_RESOURCE_ID=volc.bigasr.sauc.duration
VOLCENGINE_STT_MODEL=bigmodel
VOLCENGINE_STT_LANGUAGE=zh

# 豆包语音 TTS（文字转语音）：双向流式 WebSocket；音色须已获账户授权。
VOLCENGINE_TTS_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_SPEAKER=zh_female_vv_uranus_bigtts
VOLCENGINE_TTS_SAMPLE_RATE=24000

# 网络搜索服务商：volcengine（豆包搜索）或 bocha（博查搜索）。
SEARCH_PROVIDER=volcengine

# 豆包搜索 Custom API（网络搜索工具）。
VOLCENGINE_SEARCH_API_KEY=
VOLCENGINE_SEARCH_CUSTOM_ENDPOINT=https://open.feedcoopapi.com/search_api/web_search
VOLCENGINE_SEARCH_TIMEOUT_MS=10000

# 博查 Web Search API（选择 bocha 时使用）。
BOCHA_SEARCH_API_KEY=
BOCHA_SEARCH_ENDPOINT=https://api.bochaai.com/v1/web-search
BOCHA_SEARCH_TIMEOUT_MS=10000

# 原生 MSFS CLI。开发态可指向本地构建；安装态留空时使用 resources/msfs/msfs.exe。
MSFS_CLI_PATH=
MSFS_CLI_TIMEOUT_MS=15000
MSFS_CLI_MAX_CONCURRENCY=2
MSFS_TRACK_INTERVAL_MS=3000
MSFS_TRACK_MAX_POINTS=120
